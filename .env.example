# Railway injects DATABASE_URL automatically when you add a Postgres plugin —
# you shouldn't need to set this by hand on Railway.
#
# If you're using Supabase for the database instead, paste its connection
# string here (Supabase dashboard -> Project Settings -> Database -> Connection
# string -> URI). Use the direct connection (port 5432) or Session pooler,
# NOT the Transaction pooler (port 6543) -- this app holds a persistent
# connection pool that doesn't play well with transaction-mode pooling.
# SSL turns on automatically for supabase.com / railway hosts; PGSSL=true
# below is only needed for other managed providers.
DATABASE_URL=postgres://user:password@localhost:5432/classroom_chat

# Set this to a long random string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-something-random

NODE_ENV=production
PORT=3000
